// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("MONGO_URI")
}

model Reminders {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId String
    reminder String
    isHarsh Boolean
}
